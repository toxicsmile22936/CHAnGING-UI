{
  "manifest_version": 3,
  "name": "Trump SEO Tools Extension",
  "description": "This is an official Manifest V3 extension for Trump SEO for accessing our tools Developed by Noman Graphics nomangraphics.com",
  "version": "5.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "cookies",
    "browsingData",
    "unlimitedStorage",
    "notifications",
    "webRequest",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "md.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "shh.js",
        "ab.js",
        "sd.js",
        "aa.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
